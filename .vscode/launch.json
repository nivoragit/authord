{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Deno CLI (debug) — prompt for basic auth",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/lib/cli.ts",
      "runtimeExecutable": "/Users/madushika/.deno/bin/deno",
      "runtimeArgs": ["run", "-A", "--inspect-wait"],
      "args": [
        "confluence-single",
        "--base-url", "https://confluence.sumihiran.dev",
        "--basic-auth", "${input:basicAuth}",
        "--page-id", "163983",
        "/Users/madushika/authord/sample/writerside"
      ],
      "attachSimplePort": 9229,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std"
    },
    {
      "name": "Deno Test (debug) — xast_xml.test.ts",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/Users/madushika/.deno/bin/deno",
      "runtimeArgs": [
        "test",
        "-A",
        "--inspect-wait",
        "tests/parse/xast_xml.test.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "attachSimplePort": 9229,
      "outputCapture": "std"
    }
  ],
  "inputs": [
    {
      "id": "basicAuth",
      "type": "promptString",
      "description": "Enter basic auth as username:password",
      "password": true
    }
  ]
}
